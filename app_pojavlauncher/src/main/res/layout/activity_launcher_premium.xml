<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background">

    <!-- Animated Background -->
    <View
        android:id="@+id/animated_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/dark_bg_primary"
        android:alpha="0.7" />

    <!-- Main Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/app_logo"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_launcher_foreground"
                android:contentDescription="@string/app_name" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/dark_text_primary"
                android:layout_marginStart="16dp" />

            <ImageButton
                android:id="@+id/btn_settings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_settings"
                android:contentDescription="@string/settings" />
        </LinearLayout>

        <!-- Dashboard Content -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Large Play Button -->
                <Button
                    android:id="@+id/btn_play"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:text="@string/play"
                    android:textSize="24sp"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:background="@drawable/ripple_button"
                    android:layout_marginBottom="16dp"
                    android:drawableTop="@drawable/ic_play_button" />

                <!-- Version & Account Selection -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <Spinner
                        android:id="@+id/spinner_version"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/glass_card_bg" />

                    <Spinner
                        android:id="@+id/spinner_account"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/glass_card_bg" />
                </LinearLayout>

                <!-- Info Cards -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <!-- Memory Card -->
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/glass_card_bg">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="12dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/memory_usage"
                                android:textSize="12sp"
                                android:textColor="@color/dark_text_secondary" />
                            <TextView
                                android:id="@+id/text_memory"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="8GB / 16GB"
                                android:textSize="16sp"
                                android:textColor="@color/primary_green"
                                android:textStyle="bold"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>
                    </FrameLayout>

                    <!-- Java Card -->
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/glass_card_bg">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="12dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/java_version"
                                android:textSize="12sp"
                                android:textColor="@color/dark_text_secondary" />
                            <TextView
                                android:id="@+id/text_java"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Java 17"
                                android:textSize="16sp"
                                android:textColor="@color/primary_red"
                                android:textStyle="bold"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>
                    </FrameLayout>

                    <!-- FPS Card -->
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/glass_card_bg">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="12dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/renderer_info"
                                android:textSize="12sp"
                                android:textColor="@color/dark_text_secondary" />
                            <TextView
                                android:id="@+id/text_renderer"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="OpenGL 4.6"
                                android:textSize="16sp"
                                android:textColor="@color/accent_gold"
                                android:textStyle="bold"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>
                    </FrameLayout>
                </LinearLayout>

                <!-- News Banner -->
                <FrameLayout
                    android:id="@+id/news_banner"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:background="@drawable/glass_card_bg"
                    android:layout_marginBottom="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Latest News"
                            android:textSize="16sp"
                            android:textColor="@color/dark_text_primary"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/text_news"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Welcome to Bangla Launcher!"
                            android:textSize="14sp"
                            android:textColor="@color/dark_text_secondary"
                            android:layout_marginTop="8dp"
                            android:ellipsize="end"
                            android:maxLines="2" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>
        </ScrollView>

        <!-- Bottom Navigation -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:background="@color/dark_bg_secondary"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/nav_home"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:src="@drawable/ic_home"
                android:contentDescription="@string/home" />

            <ImageButton
                android:id="@+id/nav_downloads"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:src="@drawable/ic_download"
                android:contentDescription="@string/downloads" />

            <ImageButton
                android:id="@+id/nav_accounts"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:src="@drawable/ic_accounts"
                android:contentDescription="@string/accounts" />

            <ImageButton
                android:id="@+id/nav_settings"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:src="@drawable/ic_settings"
                android:contentDescription="@string/settings" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>